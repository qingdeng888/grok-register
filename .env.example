# 本地构建时保持下面默认值；使用 GHCR 时改为 ghcr.io/kaibush/grok-register:latest
GROK_REGISTER_IMAGE=grok-register:local
# 会话 Cookie 是否带 Secure 标志：0=允许纯 HTTP 访问（默认），1=强制 HTTPS（浏览器不在 HTTP 下发送 Cookie，会导致无法登录）
GROK_WEB_COOKIE_SECURE=0
GROK_SHM_SIZE=1gb
XVFB_SCREEN=1920x1080x24
TZ=UTC

# 可选 OutlookEmail 邮箱池（docker compose --profile outlookemail up -d）
OUTLOOKEMAIL_IMAGE=ghcr.io/assast/outlookemail:latest
OUTLOOKEMAIL_PORT=5000
OUTLOOKEMAIL_LOGIN_PASSWORD=change-this-outlookemail-password
# 部署前请替换为随机长字符串：python3 -c 'import secrets; print(secrets.token_hex(32))'
OUTLOOKEMAIL_SECRET_KEY=change-this-outlookemail-secret-key
OUTLOOKEMAIL_DOCKER_UPDATE_ENABLED=true
# 特殊 Docker daemon/socket 代理环境可调整，例如 1.52
OUTLOOKEMAIL_DOCKER_UPDATE_API_VERSION=1.41
# 使用自有 Azure 应用时替换下面两个值
OUTLOOKEMAIL_OAUTH_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
OUTLOOKEMAIL_OAUTH_REDIRECT_URI=http://localhost:8080
